# Copy this file to .env.local and fill in the keys. NEVER commit .env.local.
# Keys are only used on the server (API routes) — they never reach the phone.

# Google AI Studio key — AI teacher (Gemini) — needed from Thursday
GEMINI_API_KEY=

# Google Cloud Text-to-Speech key — German + Telugu voices — needed from Wednesday
GOOGLE_TTS_API_KEY=

# Optional fallback for speech-to-text (Groq Whisper)
GROQ_API_KEY=
